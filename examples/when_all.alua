-- Task.when_all：并行等待多个 delay，汇总结果
-- 期望 RESULT: 60  （10+20+30）

async function run_when_all()
  local results = await Task.when_all({
    delay(10),
    delay(20),
    delay(30),
  })
  local sum = 0
  local i = 1
  while i <= #results do
    sum = sum + results[i]
    i = i + 1
  end
  return sum
end
